# Copy to .env and fill in the values: cp .env.example .env

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Log level for the pino logger (fatal | error | warn | info | debug | trace).
# Defaults to debug in development and info in production.
LOG_LEVEL=

# Database (PostgreSQL, used by Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oir_hub

# Better Auth (generate secret with: npx @better-auth/cli secret)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── RAG assistant ───────────────────────────────────────────
# The assistant is not part of the app at the moment, so none of these are read.
# Restore them together with lib/external/ when the chat comes back.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# CHAT_MODEL=qwen2.5:7b
# EMBEDDING_MODEL=bge-m3

# ── Object storage (MinIO, S3-compatible) ───────────────────
# Where uploaded media files (bulletin PDFs, forms) are stored.
# The endpoint must be reachable from the browser too: download links are
# presigned URLs pointing straight at it.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Create this bucket once in the MinIO console (http://localhost:9001).
MINIO_BUCKET=oir
