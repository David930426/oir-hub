# ─────────────────────────────────────────────────────────────
# OIR Hub — environment variables
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
# Public base URL of the app (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────
# Used by Drizzle ORM and drizzle-kit (see drizzle.config.ts).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oir_hub

# ── Better Auth ──────────────────────────────────────────────
# Secret for signing sessions/tokens. Generate one with:
#   npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# Base URL Better Auth runs on (usually same as the app URL).
BETTER_AUTH_URL=http://localhost:3000

# ── Vector database (Qdrant) — RAG retrieval ─────────────────
QDRANT_URL=http://localhost:6333
# Leave empty for a local unauthenticated Qdrant instance.
QDRANT_API_KEY=

# ── LLM / Embeddings ─────────────────────────────────────────
# Local models served by Ollama (e.g. qwen2.5:7b).
OLLAMA_BASE_URL=http://localhost:11434
# Default chat model used by the RAG chatbot.
CHAT_MODEL=qwen2.5:7b
# Embedding model used to index document chunks.
EMBEDDING_MODEL=bge-m3

# Optional hosted providers (only if used for model comparison).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
