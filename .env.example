# Copy to .env and fill in the values: cp .env.example .env

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Log level for the pino logger (fatal | error | warn | info | debug | trace).
# Defaults to debug in development and info in production.
LOG_LEVEL=

# Database (PostgreSQL, used by Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oir_hub

# Better Auth (generate secret with: npx @better-auth/cli secret)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Qdrant (vector DB for RAG retrieval, leave key empty for local unauthenticated instance)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Ollama (local LLM + embeddings)
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3

# Optional hosted providers (only needed for model comparison)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
